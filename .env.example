TZ=Europe/Berlin
YOUTUBE_API_KEY=replace_me
HA_URL=http://homeassistant.local:8123
HA_WEBHOOK_ID=smarttube_partyqueue_play
ADMIN_PASSWORD=change-me
DATA_DIR=/app/data
MAX_VIDEO_MINUTES=12
MAX_REQUESTS_PER_GUEST=3
SEARCH_CACHE_HOURS=168
SEARCH_MIN_LENGTH=3
SEARCH_RESULTS=50
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_SEARCH_WARNING_AT=80
YOUTUBE_SEARCH_HARD_STOP_AT=98
BASE_PLAYLIST_RECENT_EXCLUDE=20
PRESTART_SECONDS=4
IDLE_FALLBACK_DELAY=2
PRESTART_IDLE_GUARD=10
EXTERNAL_SKIP_MIN_PREVIOUS=30
EXTERNAL_SKIP_MAX_NEW=8
PLAY_CONFIRM_TIMEOUT=6
PLAY_RETRY_TIMEOUT=10
PLAY_WEBHOOK_TIMEOUT=5
PLAY_CONFIRM_MAX_POSITION=20
ADB_POLL_INTERVAL=2
SMARTTUBE_PACKAGE=org.smarttube.stable
DEFAULT_TV=ke75
TV_DEVICES=xi4k|Xiaomi Gästezimmer,ke75|KE75 Spielzimmer,kd70|KD70 Schlafzimmer,fiwo|FireTV Wohnzimmer,fi4k|FireTV Partykeller
